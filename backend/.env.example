NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/cloudstream
JWT_ACCESS_SECRET=replace-with-random-64-byte-hex
JWT_REFRESH_SECRET=replace-with-another-random-64-byte-hex
# 32 random bytes in hex (64 hex characters)
DATA_ENCRYPTION_KEY=replace-with-random-32-byte-hex
# 32-byte printable ASCII, or 32 bytes represented as a 64 hex string via code decoding
GUAC_TOKEN_KEY=replace-with-random-32-byte-hex
AWS_REGION=eu-west-1
AWS_CLOUDWATCH_LOG_GROUP=/cloudstream/execution
AWS_S3_BUCKET=
AWS_SQS_QUEUE_URL=
AWS_EXECUTION_ROLE=arn:aws:iam::ACCOUNT_ID:instance-profile/cloudstream-executor
AWS_EXECUTION_SECURITY_GROUP=sg-...
AWS_EXECUTION_SUBNET=subnet-...
AWS_EC2_AMI_ID=ami-...
AWS_STREAMING_CONFIGURATION=guacamole-vnc
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
VITE_STREAMING_BASE_URL=ws://localhost:8081
GUAC_HOST=127.0.0.1
GUAC_PORT=8081
GUACD_HOST=127.0.0.1
GUACD_PORT=4822
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5173/billing
SES_FROM_EMAIL=
SES_ENABLED=false
REQUIRE_ADMIN_APPROVAL=true
UPLOAD_MAX_BYTES=2147483648
MAX_SESSIONS_PER_USER=1
DEFAULT_MAX_SESSION_MINUTES=60
UPLOAD_URL_TTL_SECONDS=900
APP_PRESIGNED_GET_TTL_SECONDS=3600
IDLE_TIMEOUT_MINUTES=15
AWS_INSTANCE_MAX_AGE_MINUTES=180
ADMIN_EMAIL=
ADMIN_PASSWORD=
